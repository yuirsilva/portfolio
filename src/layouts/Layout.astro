---
import Header from "@components/nav/Header.astro";
import Favicon from "@components/visual/Favicon.astro";
import Head from "@components/Head.astro";
import Reveal from "@components/visual/Reveal.astro";

export type Namespace = "Home" | "About" | "Projects" | "404";

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    namespace: Namespace;
}

const {
    title,
    description = "Creative Developer.",
    ogImage = "/default-opengraph.png",
    namespace,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <Head
        title={`${title} — Yuri Silva`}
        description={description}
        ogImage={ogImage}
    />

    <body
        data-barba="wrapper"
        class="flex min-h-screen flex-col overflow-x-hidden font-sans text-base"
    >
        <Favicon />
        <Reveal />

        <main
            data-barba="container"
            data-barba-namespace={namespace}
            class="relative flex flex-1 flex-col"
        >
            <Header namespace={namespace} />
            <slot />
        </main>

        <style is:global>
            @tailwind base;
            @tailwind components;
            @tailwind utilities;

            @font-face {
                font-family: "he";
                src:
                    url("/fonts/he.woff2") format("woff2 supports variations"),
                    url("/fonts/he.woff2") format("woff2-variations");
                font-weight: 400 700;
                font-display: swap;
            }

            @font-face {
                font-family: "te";
                src: url("/fonts/te.woff2") format("woff2");
                font-synthesis: none;
                font-style: normal;
                font-display: swap;
            }

            ::-webkit-scrollbar {
                display: none;
            }
            body {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }

            [data-barba="container"] {
                position: absolute;
                inset: 0;
            }

            @layer base {
                :root {
                    font-synthesis: none;
                    text-rendering: optimizeLegibility;
                    -webkit-font-smoothing: antialiased;
                    -moz-osx-font-smoothing: grayscale;
                    color-scheme: light dark;

                    /* DEFAULT theme */
                    --white: theme("colors.white");
                    --black: theme("colors.black");
                    --neutral-500: theme("colors.neutral.500");
                    --primary: #2563ea;

                    --logo-primary: #2563ea;
                    --logo-secondary: theme("colors.black");
                }

                [data-theme="red"] {
                    --white: #ee0506;
                    --black: theme("colors.black");
                    --neutral-500: theme("colors.black");
                    --primary: theme("colors.black");

                    --logo-primary: theme("colors.black");
                    --logo-secondary: theme("colors.black");
                }

                [data-theme="halloween"] {
                    --white: #ff9100;
                    --black: #252422;
                    --neutral-500: #403d39;
                    --primary: #6bd425;

                    --logo-primary: #240046;
                    --logo-secondary: #9d4edd;
                }

                ::-moz-selection {
                    /* Code for Firefox */
                    color: var(--white);
                    background: var(--primary);
                }

                ::selection {
                    color: var(--white);
                    background: var(--primary);
                }

                body {
                    @apply bg-brand-white text-brand-black;
                }
            }
        </style>
        <script src="../components/ThemeToggle.ts"></script>
        <script src="../lib/barba.ts"></script>
    </body>
</html>
