---
import Layout from "@/layouts/Layout.astro";
import Link from "@components/nav/Link.astro";

import Footer from "@components/home/Footer.astro";
import HomeCanvas from "@components/home/HomeCanvas.astro";
---

<Layout
    title="Creative Developer"
    description="Creating modern interfaces, from design to code."
    namespace="Home"
>
    <HomeCanvas />
    <section
        id="home-section"
        class="fixed left-1/2 top-1/2 my-auto flex max-w-64 -translate-x-1/2 -translate-y-1/2 flex-col gap-6 uppercase [color:_rgba(0,0,0,0)]"
    >
        <h1
            id="heading"
            class="relative cursor-pointer select-none whitespace-nowrap text-5xl font-bold tracking-tight"
        >
            Yuri Silva
        </h1>
        <div>
            <p>Creative Developer</p>
            <p>Based in São Paulo, Brazil</p>
        </div>
        <div>
            <div class="flex justify-between">
                <Link href="/about" class="underline-offset-2 hover:underline"
                    >About me</Link
                >
                <p>‘24</p>
            </div>
            <div class="flex justify-between">
                <Link
                    href="/projects"
                    class="underline-offset-2 hover:underline">Projects</Link
                >
                <p>Dev</p>
            </div>
        </div>
    </section>
    <Footer />
</Layout>
