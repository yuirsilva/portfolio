---
import Layout from "@/layouts/Layout.astro";

import ProjectsCanvas from "@components/projects/ProjectCanvas.astro";
import { Image } from "astro:assets";

import TIMBRE from "@/assets/timbre_project.png";
import HEARNOEVIL from "@/assets/hearnoevil_poster.png";
import ALIEN from "@/assets/alien_poster.png";
import EXAMPLE0 from "@/assets/example0.jpg";
import EXAMPLE1 from "@/assets/example1.jpg";
import EXAMPLE2 from "@/assets/example2.jpg";
import EXAMPLE3 from "@/assets/example3.jpg";
import EXAMPLE4 from "@/assets/example4.jpg";
import EXAMPLE5 from "@/assets/example5.jpg";
---

<Layout title="Work" description="My work." namespace="Projects">
    <div
        class="pointer-events-none invisible fixed top-0 -z-[999] flex w-[180px] select-none flex-wrap items-center justify-center gap-20 opacity-0"
    >
        <div class="projects-imgs flex flex-col">
            <Image
                src={TIMBRE}
                title="Timbre"
                data-year="2024"
                data-type="project"
                data-github="https://github.com/yuirsilva/timbre"
                data-website="https://timbre.yvri.vercel.app"
                alt="Timbre, a collection of sounds for your website."
            />
            <Image
                src={HEARNOEVIL}
                title="Hear no Evil (Poster)"
                data-year="2024"
                data-type="image"
                alt="Hear no Evil, See no Evil, Speak no Evil (Poster)."
            />
            <Image
                src={ALIEN}
                title="Alien (Poster)"
                data-year="2024"
                data-type="image"
                alt="An Alien inspired poster."
            />
            <Image
                src={EXAMPLE0}
                title="I no longer fear the razor guarding my heel"
                data-year="2024"
                data-type="image"
                alt="An example image"
            />
            <Image
                src={EXAMPLE1}
                title="different"
                data-year="2024"
                data-type="image"
                alt="An example image"
            />
            <Image
                src={EXAMPLE2}
                title="notequal"
                data-year="2024"
                data-type="image"
                alt="An example image"
            />
            <Image
                src={EXAMPLE3}
                title="equal"
                data-year="2024"
                data-type="image"
                alt="An example image"
            />
            <Image
                src={EXAMPLE4}
                title="same"
                data-year="2024"
                data-type="image"
                alt="An example image"
            />
            <Image
                src={EXAMPLE5}
                title="test"
                data-year="2024"
                data-type="image"
                alt="An example image"
            />
        </div>
    </div>
    <ProjectsCanvas />
    <script src="../../components/projects/projectCanvas.ts"></script>
</Layout>
